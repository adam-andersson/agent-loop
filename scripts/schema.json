{
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "summary", "files_inspected", "findings", "resolutions"],
  "properties": {
    "verdict": { "type": "string", "enum": ["approve", "revise"] },
    "summary": { "type": "string" },
    "files_inspected": { "type": "array", "items": { "type": "string" } },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "area", "claim", "evidence", "confidence", "recommendation"],
        "properties": {
          "id": { "type": "string" },
          "severity": { "type": "string", "enum": ["blocking", "non-blocking", "nit"] },
          "area": { "type": "string" },
          "claim": { "type": "string" },
          "evidence": { "type": "string" },
          "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
          "recommendation": { "type": "string" }
        }
      }
    },
    "resolutions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "evidence"],
        "properties": {
          "id": { "type": "string" },
          "status": { "type": "string", "enum": ["resolved", "still-open", "withdrawn"] },
          "evidence": { "type": "string" }
        }
      }
    }
  }
}
